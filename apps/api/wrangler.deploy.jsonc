        "MoneyLedger"
      ]
    }
  ],
  "vars": {
    "BUNNY_PULL_ZONE_ID": "6769737",
    "BUNNY_COLLECT_HOST": "adslop-event-collector-j6mco.bunny.run"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
