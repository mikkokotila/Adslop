{
  "name": "adslop-api-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "MONEY",
        "class_name": "MoneyLedger"
      }
