{
  "name": "adslop-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "MONEY", "class_name": "MoneyLedger" }]
  },
  "exports": {
    "MoneyLedger": { "type": "durable-object", "storage": "sqlite" }
  }
}
