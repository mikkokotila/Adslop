# What belongs in the sdist. The sdist is the source-inspection bundle, not a
# repository snapshot: it carries the package, the public docs, the tests, and
# the metadata a consumer needs to judge the project. It deliberately excludes
# the enforcement plane -- governance/ is how this repository is built, not
# something a consumer installs.

include README.md
# Required inside the sdist: `python -m build` builds the wheel FROM the
# sdist, so the backend must travel with it.
include build_backend.py
include LICENSE
include CHANGELOG.md
include CLAUDE.md
include AGENTS.md
include AUTHORS
include NOTICE
include CITATION.cff
include CODE_OF_CONDUCT.md
include CONTRIBUTING.md
include GOVERNANCE.md
include MAINTAINERS.md
include SECURITY.md
include SUPPORT.md
include THIRD_PARTY.md
include governance.yml
include .markdownlint.json

recursive-include docs *.md
recursive-include new_repository_template *.md
recursive-include tests *.py
recursive-include requirements *.in *.txt

prune .github
prune .venv
prune docs-site
prune fuzz
prune governance
prune build
prune dist

global-exclude __pycache__ *.py[cod] .DS_Store
